# PostgreSQL
POSTGRES_DB=osberplite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Connection String (API -> PostgreSQL)
CONNECTION_STRING=Host=postgres;Port=5432;Database=osberplite;Username=postgres;Password=your_password_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars_here

# SAP Integration
SAP_API_BASE_URL=https://your-sap-instance.com/api
SAP_API_KEY=your_sap_api_key_here
